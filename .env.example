# Совпадает с параметрами сервиса db из docker-compose.yml
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

# Порт бэкенда (apps/api)
PORT=3001

# Адрес бэкенда для фронтенда (apps/web)
API_URL=http://localhost:3001/api

# Добавлено для авторизации (auth.md)
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

